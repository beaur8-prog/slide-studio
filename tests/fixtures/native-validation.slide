          "type": "text",
          "x": 484,
          "y": 502,
          "width": 355,
          "height": 100,
          "rotation": 0,
          "opacity": 1,
          "text": "익숙한 방식에서 한 걸음 벗어나\n새로운 관점을 탐색합니다.",
          "fontFamily": "Arial",
          "fontSize": 22,
          "color": "#62726A",
          "align": "left",
          "verticalAlign": "top"
        },
        {
          "id": "724092fa-e355-4ff3-a15b-51118bf59aaf",
          "type": "text",
          "x": 884,
          "y": 310,
          "width": 140,
