{
  "name": "slide-studio",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "An independent, local-first presentation editor for macOS and Windows",
  "author": "Slide Studio",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5190",
    "start": "node scripts/launch-desktop.cjs",
    "desktop": "node scripts/launch-desktop.cjs --dev",
    "test": "playwright test",
    "package": "npm run build && node scripts/package-mac.cjs",
    "package:mac": "npm run build && node scripts/package-mac.cjs",
    "package:win": "npm run build && node scripts/package-win.cjs"
  },
  "dependencies": {
    "@fontsource/carlito": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.0.0",
    "prettier": "3.6.2",
    "resedit": "^3.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
